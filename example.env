# Local development settings: `cp example.env .env`. Matches docker-compose.yaml; nothing here is a real secret.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=chtc-userapp
DB_USER=postgres
DB_PASSWORD=postgres
# Must match SECRET_KEY in chtc-user-ui so the UI's dev login token verifies. Dev only: never use in a deployment.
SECRET_KEY=local-dev-only
